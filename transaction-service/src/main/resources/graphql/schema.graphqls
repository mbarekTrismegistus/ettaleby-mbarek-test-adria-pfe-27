enum TransactionType {
    PAYMENT
    TRANSFER_OUT
    TRANSFER_IN
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
    type: TransactionType!
    transferId: ID
}

type Transfer {
    transferId: ID!
    debit: Transaction!
    credit: Transaction!
}

input PaymentInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    sourceAccountId: ID!
    targetAccountId: ID!
    amount: Float!
    currency: String!
    country: String
}

type Query {
    transactions: [Transaction!]!
    transactionById(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]!
    maxTransactionAmount: Float!
}

type Mutation {
    createPayment(input: PaymentInput!): Transaction!
    transfer(input: TransferInput!): Transfer!
}
